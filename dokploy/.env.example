# Copy to .env (or paste into Dokploy -> Environment). Never commit .env.
REGISTRY=ghcr.io/engabo3lia
APP_VERSION=latest

# Endpoint clients dial. Use wss:// with the public hostname.
ORCA_PAIRING_ADDRESS=wss://orca.majra.dev

TZ=Africa/Cairo

# Optional
ORCA_MOBILE_PAIRING=false
ORCA_GRANT_DESKTOP_CONTROL=false
ORCA_PROJECT_ROOT=
ORCA_EXTRA_ARGS=

GIT_AUTHOR_NAME=Orca Agent
GIT_AUTHOR_EMAIL=orca@majra.dev

# Build-from-source variant only (docker-compose.build.yml)
ORCA_VERSION=1.4.239
ORCA_APPIMAGE_SHA512=0Hqinbml/LdjLJlxsWrUGzsV+RvDK0g7zJTkEd6s0hpq9s/DM4lIiuYE8qQ/XjtJDwJfOGB/rfNEG4GO4Et23w==
OPENCODE_VERSION=1.19.4
CLAUDE_CODE_VERSION=2.1.310
CODEX_VERSION=0.164.0
